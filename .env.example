# =============================================================================
# Copiez ce fichier en `.env` puis adaptez les valeurs :
#   cp .env.example .env
# Docker Compose lit automatiquement `.env` à la racine du projet.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_password
POSTGRES_DB=todo_db

# --- Backend : connexion SQLAlchemy ----------------------------------------
# L'hôte est `db` = nom du service PostgreSQL dans docker-compose.yml.
# Doit rester cohérent avec POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
DATABASE_URL=postgresql://todo_user:todo_password@db:5432/todo_db

# --- Backend : CORS -------------------------------------------------------
# Origines autorisées à appeler l'API (séparées par des virgules).
CORS_ORIGINS=http://localhost:3000

# --- Backend : Authentification JWT --------------------------------------
# Secret de signature des tokens. À REMPLACER par une valeur aléatoire longue.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend --------------------------------------------------------------
# URL de l'API vue depuis le NAVIGATEUR (pas depuis le réseau Docker interne).
NEXT_PUBLIC_API_URL=http://localhost:8000
